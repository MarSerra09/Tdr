# =======================================================
# 1. CLONAR I PREPARAR CARPETES DEL PROJECTE
# =======================================================
git clone https://github.com/jwngr/sdow.git
cd "C:\Users\MarSerraDomínguez\Downloads\sdow-main\sdow-main"

# Configurar permisos d'execució a PowerShell
Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force

# =======================================================
# 2. ENTORN VIRTUAL I DEPENDÈNCIES DE PYTHON
# =======================================================
python -m venv env
& ".\env\Scripts\Activate.ps1"
python -m pip install --upgrade pip
python -m pip install flask flask-cors pandas openpyxl
pip install -r requirements.txt

# =======================================================
# 3. PROCESSAMENT DE LES DADES DE VIQUIPÈDIA (SQL / TXT)
# =======================================================
# Arrencar el script de descàrrega dels dumps de Viquipèdia i generació inicial
bash buildDatabase.sh 20260701

# Processament, filtratge de dades i combinació d'enllaços
python netejar_sql.py
python prune_pages_file.py dump/pages.txt dump/redirects.txt
python combine_grouped_links_files.py

# =======================================================
# 4. CREACIÓ I ESTRUCTURA DE LA BASE DE DADES (SQLITE)
# =======================================================
# Creació de la base de dades final i de la taula de cerques (searches.sqlite)
python crear_db_final.py
python -c "import sqlite3; conn = sqlite3.connect('sdow/searches.sqlite'); conn.execute('CREATE TABLE IF NOT EXISTS searches (source_id INT, target_id INT, duration REAL, degrees_count INT, paths_count INT, paths TEXT, t INT);'); conn.close()"
python -c "import sqlite3; conn = sqlite3.connect('searches.sqlite'); conn.execute('CREATE TABLE IF NOT EXISTS searches (source_id INT, target_id INT, duration REAL, degrees_count INT, paths_count INT, paths TEXT, t INT)'); conn.commit(); conn.close()"

# =======================================================
# 5. INICI DEL SERVIDOR BACKEND (FLASK)
# =======================================================
$env:FLASK_APP = "sdow.server"
flask run --port=5000

# Comprovació de funcionament de l'API REST
Invoke-RestMethod -Uri "http://localhost:5000/paths" -Method Post -ContentType "application/json" -Body '{"source": "Catalunya", "target": "Barcelona"}'

# =======================================================
# 6. CONFIGURACIÓ, DEPENDÈNCIES I EXECUCIÓ DEL FRONTEND
# =======================================================
cd website

# Afegir el Node.js portable al PATH
$env:Path += ";C:\Users\MarSerraDomínguez\Downloads\node-v24.20.0-win-x64\node-v24.20.0-win-x64"

# Instal·lació de dependències del client (312 paquets)
npm install --engine-strict=false

# Arrencar la web amb Vite (localhost:3000)
npm start
